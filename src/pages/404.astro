---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---
<MainGridLayout title="페이지를 찾을 수 없습니다" noindex={true}>
	<div class="card-base w-full px-6 py-6 md:px-9">
		<h1 class="mb-3 text-2xl font-bold text-90">페이지를 찾을 수 없습니다</h1>
		<p class="mb-4 text-75">주소가 바뀌었거나 삭제된 페이지입니다.</p>
		<a class="font-medium text-90 underline" href="/">홈으로 돌아가기</a>
	</div>
</MainGridLayout>
