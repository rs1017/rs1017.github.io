---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const policy = await getEntry("spec", "privacy");
if (!policy) throw new Error("개인정보처리방침을 찾을 수 없습니다.");
const { Content } = await render(policy);
---
<MainGridLayout title="개인정보처리방침" description="NaksuGames의 개인정보 처리 및 문의 안내">
	<div class="card-base w-full px-6 py-6 md:px-9">
		<Markdown><Content /></Markdown>
	</div>
</MainGridLayout>
